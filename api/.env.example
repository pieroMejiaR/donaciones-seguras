# Plantilla de variables de entorno para funciones Lambda / Authorizer
# Copiar este archivo a .env y colocar los valores reales de su entorno.
# NUNCA subir archivos .env con datos reales al repositorio.

AWS_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-client-id-here
COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_XXXXXXXXX
