# Copia este archivo como web/.env.local y reemplaza los valores.
# Vite publica las variables VITE_* en el bundle: nunca pongas secretos aquí.

# Salida CognitoIssuerUrl del stack:
# https://cognito-idp.us-east-2.amazonaws.com/<user-pool-id>
VITE_OIDC_AUTHORITY=

# Salida UserPoolClientId del stack (cliente público, sin secreto).
VITE_OIDC_CLIENT_ID=

# Dominio del managed login, sin barra final:
# https://<prefijo>.auth.us-east-2.amazoncognito.com
VITE_OIDC_DOMAIN=

# Scopes separados por espacios. Deben estar registrados en el app client.
# Estos nombres siguen design.md §4; confírmalos contra la plantilla desplegada.
VITE_OIDC_SCOPE=openid email api/projects.write api/donations.write api/donations.read api/audit.read

# URL base del API, sin barra final. Se admite http solo para localhost.
VITE_API_BASE_URL=
