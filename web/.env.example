# Plantilla de configuracion para la SPA (React + oidc-client-ts)
# Copiar este archivo a .env y colocar los valores reales de su entorno.
# NUNCA subir archivos .env con datos reales al repositorio.

VITE_COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-cognito-client-id-here
VITE_COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_XXXXXXXXX
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_XXXXXXXXX
VITE_COGNITO_REDIRECT_URI=http://localhost:5173
VITE_COGNITO_LOGOUT_URI=http://localhost:5173
VITE_COGNITO_SCOPES=openid email profile api/projects.write api/donations.*
